# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback

# Facebook / Meta OAuth Configuration
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social/facebook/callback

# Security & Token Encryption
VAULT_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key
SECRET_KEY=your_jwt_signing_secret_key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin & 2FA Configuration
ADMIN_USERNAME=admin
ADMIN_TOTP_SECRET=your_base32_totp_secret_key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database Configuration (Optional override, defaults to PostgreSQL in production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/social_scheduler
